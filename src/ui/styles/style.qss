/* 主窗口样式 */
QMainWindow {
    background-color: #f5f5f5;
}

/* 分组框样式 */
QGroupBox {
    font-weight: bold;
    border: 2px solid #cccccc;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #2c3e50;
}

/* 按钮样式 */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1c6ea4;
}

EnhancedSimpleComboBox {
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 8px 12px;
    background-color: white;
    font-size: 13px;
    min-height: 20px;
}
EnhancedSimpleComboBox:hover {
    border-color: #3498db;
}
EnhancedSimpleComboBox:focus {
    border-color: #2980b9;
}
EnhancedSimpleComboBox::drop-down {
    border: none;
    width: 30px;
}
EnhancedSimpleComboBox QAbstractItemView {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: white;
    selection-background-color: #e3f2fd;
    selection-color: #333333;
    outline: none;
    padding: 4px;
    min-width: 300px;
}
EnhancedSimpleComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 3px;
    margin: 1px;
}
EnhancedSimpleComboBox QAbstractItemView::item:hover {
    background-color: #f5f5f5;
}
EnhancedSimpleComboBox QAbstractItemView::item:selected {
    background-color: #e3f2fd;
}

/* 微调框样式 */
QSpinBox {
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 5px;
    background-color: white;
}

QSpinBox:hover {
    border-color: #3498db;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background-color: #eeeeee;
    border-radius: 2px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #dddddd;
}

/* 选项卡样式 */
QTabWidget::pane {
    border: 1px solid #cccccc;
    background-color: white;
}

/* 状态栏样式 */
QStatusBar {
    background-color: #2c3e50;
    color: white;
}